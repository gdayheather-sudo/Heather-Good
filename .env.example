# ── ETSY ──────────────────────────────────────────────────────────────────────
ETSY_API_KEY=your_etsy_api_key_here
ETSY_SHOP_ID=biglittlepupclub

# ── ANTHROPIC ─────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ── CANVA CONNECT API (LinkedIn graphic generator) ────────────────────────────
# Generate a token at: https://www.canva.com/developers/
# Scopes needed: design:content:write, design:meta:read,
#                brandtemplate:content:read, brandtemplate:meta:read, asset:read
CANVA_API_TOKEN=your_canva_api_token_here

# Brand template IDs — create two templates in Canva (one per size) with named
# text elements: hook | body_text | cta | footer
# Template ID is in the URL: canva.com/brand-templates/<ID>/edit
CANVA_SQUARE_TEMPLATE_ID=your_square_template_id_here
CANVA_PORTRAIT_TEMPLATE_ID=your_portrait_template_id_here

# ── PIPELINE CONFIG ───────────────────────────────────────────────────────────
# Set to true for report-only mode (no live posting)
DRY_RUN=true
# Minimum score (1-10) for a listing to get content generated
MIN_SCORE=7
# Force re-fetch from Etsy even if cache exists
FORCE_REFRESH=false
# Use Haiku for reviewer agent to save ~70% on review costs
USE_HAIKU_FOR_REVIEW=true

# ── PINTEREST (only needed if DRY_RUN=false) ──────────────────────────────────
# Get from: https://developers.pinterest.com → your app → Generate access token
# Scopes needed: pins:write, boards:read
PINTEREST_ACCESS_TOKEN=
PINTEREST_USERNAME=biglittlepupclub

# ── INSTAGRAM / META (only needed if DRY_RUN=false) ───────────────────────────
# Requires: Instagram Business account + linked Facebook Page + approved Meta app
# See README for full setup guide
INSTAGRAM_USER_ID=
INSTAGRAM_ACCESS_TOKEN=
# Long-lived tokens expire after 60 days — see publish-log.json for refresh reminder

# Postgres connection string
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ndis_clarity?schema=public"

# Required: 32+ random bytes for JWT signing (e.g. `openssl rand -base64 48`)
AUTH_SECRET="replace-with-long-random-secret"

# Required: 32 bytes (base64) used to encrypt sensitive participant fields at rest
# Generate with: `openssl rand -base64 32`
DATA_ENCRYPTION_KEY="replace-with-32-byte-base64-key"

# Optional: enable AI structuring + report narratives. If omitted the system
# falls back to a deterministic local formatter so the app remains usable.
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-4-6"

# Public base URL used to build sharing links for external viewers
APP_URL="http://localhost:3000"

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Service-role key — server only, NEVER expose to the browser
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Storage bucket for raw voice recordings
SUPABASE_AUDIO_BUCKET=intake-audio

# --- Anthropic (Claude) ---
ANTHROPIC_API_KEY=sk-ant-...

# --- OpenAI (Whisper transcription only) ---
OPENAI_API_KEY=sk-...

# --- Resend (transactional email) ---
RESEND_API_KEY=re_...
RESEND_FROM="The Clarity Hub <hello@clarityhub.com.au>"
HEATHER_EMAIL=heather@clarityhub.com.au

# --- App ---
# Public base URL, used to build absolute links inside emails
NEXT_PUBLIC_APP_URL=https://clarityhub.com.au
# Link to the Supabase admin table view (shown in Heather's email footer)
SUPABASE_ADMIN_URL=https://supabase.com/dashboard/project/your-project/editor

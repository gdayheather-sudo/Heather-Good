# Optional. If set, the platform uses ElevenLabs neural TTS for read-aloud
# instead of the browser's built-in voice. Dramatically better for phonics
# (digraphs sh/ch/th, isolated phonemes).
#
# 1. Sign up at https://elevenlabs.io (free tier = 10k chars/month).
# 2. Profile -> API Keys -> create one, paste it below.
# 3. (Optional) Pick a voice ID from https://elevenlabs.io/app/voice-library.
#    Default is "Charlotte" (en-GB female - closest accessible match to en-AU).
#    To use your own voice: clone it on the paid tier ($5/mo) and paste
#    the voice ID from your library.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_turbo_v2_5

# Server port (default 3000)
PORT=3000

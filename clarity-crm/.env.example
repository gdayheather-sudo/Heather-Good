# Supabase (new clarity-crm project)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Service role key — server-only, never expose to the browser. Optional for v1.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Anthropic (new key for clarity-crm). Server-side only.
ANTHROPIC_API_KEY=sk-ant-xxxx
# Optional override; defaults to a Claude Sonnet 4 model id in src/lib/anthropic.ts
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# App
NEXT_PUBLIC_SITE_URL=http://localhost:3000

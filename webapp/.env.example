# Social Studio — optional environment configuration.
# You do NOT need to fill this in: API keys can be entered directly in the app's
# Settings page and are stored in the local database. These env vars simply act
# as defaults / overrides if you prefer file-based config.

# Port the local server listens on (default 4477)
PORT=4477

# Optional default API keys (otherwise set them in the Settings page)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Optional model overrides
# Claude model used for caption/copy generation
ANTHROPIC_MODEL=claude-opus-4-8
# OpenAI chat model used when you pick ChatGPT for copy generation
OPENAI_MODEL=gpt-4o
# OpenAI image model used for image generation
OPENAI_IMAGE_MODEL=gpt-image-1
